# NexMeet Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun

# Güvenlik
SECRET_KEY=BURAYA_EN_AZ_32_KARAKTER_RASTGELE_BIR_DEGER_GIRIN
ALLOWED_ORIGINS=http://localhost:8000,https://sizin-domain.com

# Dosya yükleme
MAX_FILE_SIZE_MB=50
UPLOADS_DIR=uploads

# Sunucu
HOST=0.0.0.0
PORT=8000

# Üyelik veritabanı (MySQL) — gerçek değerleri yalnız .env dosyanıza yazın
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nexmeet
DB_USER=BURAYA_DB_KULLANICISI
DB_PASSWORD=BURAYA_DB_PAROLASI

# Doğrulama ve sıfırlama bağlantılarının kök adresi
PUBLIC_BASE_URL=https://sizin-domain.com

# E-posta: smtp (gerçek gönderim) veya dosya (test; MAIL_DIR'e .txt yazar)
MAIL_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
MAIL_DIR=mail_kutusu
